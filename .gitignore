# Build output
target/
*.class

# Reports + logs (generated on every run)
logs/
allure-results/
allure-report/
extent-reports/
test-output/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS
Thumbs.db
.DS_Store

# Secrets (never commit)
*.env
.env
application-secret.properties
application-local.properties
src/main/resources/application-local.properties
src/test/resources/application-local.properties
# Any credentials override file, in case one lands anywhere in the tree:
**/credentials.properties
**/*-credentials.properties
# Nested per-env JSON config with real secrets. `.example.json` variant
# (with placeholder values) IS committed so contributors see the shape.
src/main/resources/program_configuration.json
program_configuration.json

# ra_converter output derived from customer SoapUI project XMLs.
# The input XML is gitignored (src/main/b2b-api-ai/tools/ra_converter/
# .gitignore), and the
# EMITTED artifacts (tests, CSVs, request-body templates, audit ledger,
# flow diagrams, suite XMLs) leak customer-internal API details --
# endpoint paths, request/response schemas, test-case IDs, hardcoded
# usernames/emails/IDs. Keep them purely local. Framework files under
# src/main/java/com/ak/api/{data,reporting,rest/utilities,tests/BaseApiTest}
# and src/main/b2b-api-ai/tools/ra_converter/*.py are committed;
# suite-scoped outputs below
# are not.
_audit/
_flows/
Suites/
src/main/java/com/ak/api/rest/clients/
src/main/java/com/ak/api/support/
src/main/java/com/ak/api/templates/
src/main/resources/templates/
src/main/resources/test_data_defaults/
src/main/resources/config/
src/test/java/com/ak/api/tests/imported/
src/test/resources/csv/
src/test/resources/testng-b2b-*.xml
# Loose top-level request-body templates left over from earlier runs
# (before the suite-scoped `templates/<suite>/` layout).
src/main/resources/templates/hhonorsenroll*.json
src/main/resources/templates/http_request_*.json
src/main/resources/templates/post_activate.json
src/main/resources/templates/tokenrequest.json
src/main/resources/test_data.example.properties

# --- b2b-api-ai (nested Hilton framework) -------------------------------
# Raw ReadyAPI project exports: Hilton endpoint paths, test-case IDs and
# hardcoded test emails. The converter reads them locally; they are not
# needed to build or read the framework.
# Contents only, so the folder stays visible with its README -- git does
# not descend into an excluded DIRECTORY, so a negation inside one never
# applies.
src/main/b2b-api-ai/tools/ra_converter/input/*
!src/main/b2b-api-ai/tools/ra_converter/input/README.md
# Working snapshots taken during the refactor session.
src/main/b2b-api-ai/_rearch_snapshot/
# Env config -- ships stubbed with __SET_ME__, but never track it.
src/main/b2b-api-ai/src/main/resources/program_configuration.json
# Large run artifacts (also excluded by the nested .gitignore; belt and braces).
src/main/b2b-api-ai/logs/
src/main/b2b-api-ai/extent-reports/
src/main/b2b-api-ai/.allure/
src/main/b2b-api-ai/*.log
# More ReadyAPI exports under a second input dir.
src/main/b2b-api-ai/tools/ra_converter/single_input/
# Snapshots of generated suite XMLs -- they embed Hilton test-class FQNs.
src/main/b2b-api-ai/tools/ra_converter/_smoke_snapshot/
src/main/b2b-api-ai/tools/ra_converter/_suite_xml_snapshot/
# Converter vote store: derived from the ReadyAPI exports and embeds the same
# endpoint paths and test-case IDs. The converter rebuilds it from scratch,
# and it now self-invalidates on a vocabulary change, so omitting it is safe.
src/main/b2b-api-ai/tools/ra_converter/fluent_catalog.json
