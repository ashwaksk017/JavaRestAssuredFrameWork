<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Safety-guard contract tests. Pure unit tests - no HTTP, no database, no
  credentials. Safe to run anywhere, including CI without Hilton access.

    mvn test "-DsuiteXmlFile=src/test/resources/testng-guards.xml"
-->
<suite name="Guards">
    <test name="Guards">
        <classes>
            <class name="com.hi.api.tests.security.DbSqlGuardTest"/>
            <class name="com.hi.api.tests.db.AccountRulesDomainsTest"/>
            <class name="com.hi.api.tests.db.DomainRulesTest"/>
            <class name="com.hi.api.tests.security.SecretsRedactionTest"/>
            <class name="com.hi.api.tests.framework.ScenarioContextTest"/>
            <class name="com.hi.api.tests.framework.AsyncBudgetTest"/>
            <class name="com.hi.api.tests.framework.TokenRefreshTest"/>
            <class name="com.hi.api.tests.framework.RetryConfigKeysTest"/>
            <class name="com.hi.api.tests.framework.AuthDigestAccuracyTest"/>
            <class name="com.hi.api.tests.framework.ConfigEnvVarNamingTest"/>
            <class name="com.hi.api.tests.framework.DigestDiagnosticsTest"/>
            <class name="com.hi.api.tests.framework.PhaseRunnerTest"/>
            <class name="com.hi.api.tests.framework.LastExchangeTest"/>
            <class name="com.hi.api.dsl.TemplateRegistryTest"/>
            <class name="com.hi.api.dsl.TemplateChoiceTest"/>
            <class name="com.hi.api.dsl.TemplateManualSuiteTest"/>
            <class name="com.hi.api.dsl.ManualAuthTest"/>
            <class name="com.hi.api.dsl.SuiteNameTest"/>
            <class name="com.hi.api.dsl.OnboardingStageContractTest"/>
            <class name="com.hi.api.dsl.ManualPayloadGapsTest"/>
            <class name="com.hi.api.dsl.PhaseExpectationTest"/>
            <class name="com.hi.api.dsl.PhaseCaptureTest"/>
        </classes>
    </test>
</suite>
