<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Safety-guard contract tests. Pure unit tests - no HTTP, no database, no
  credentials. Safe to run anywhere, including CI without Hilton access.

    mvn test "-DsuiteXmlFile=src/test/resources/testng-guards.xml"
-->
<suite name="Guards">
    <test name="Guards">
        <classes>
            <class name="com.hi.api.data.ExecutionFlagTest"/>
            <class name="com.hi.api.tests.framework.ExecuteFlagEndToEndTest"/>
            <class name="com.hi.api.tests.framework.ManualTemplateExampleTest"/>
            <class name="com.hi.api.tests.framework.XrayKeyGuardTest"/>
            <class name="com.hi.api.tests.framework.XrayServerDcTest"/>
            <class name="com.hi.api.tests.framework.ConnectionReportingTest"/>
            <class name="com.hi.api.auth.AuthLoggingTest"/>
            <class name="com.hi.api.tests.security.DbSqlGuardTest"/>
            <class name="com.hi.api.tests.db.AccountRulesDomainsTest"/>
            <class name="com.hi.api.tests.db.DomainRulesTest"/>
            <class name="com.hi.api.tests.security.SecretsRedactionTest"/>
            <class name="com.hi.api.tests.framework.ScenarioContextTest"/>
            <class name="com.hi.api.tests.framework.AsyncBudgetTest"/>
            <class name="com.hi.api.tests.framework.TokenRefreshTest"/>
            <class name="com.hi.api.tests.framework.RetryConfigKeysTest"/>
            <class name="com.hi.api.tests.framework.AuthDigestAccuracyTest"/>
            <class name="com.hi.api.tests.framework.ConfigEnvVarNamingTest"/>
            <class name="com.hi.api.tests.framework.DigestDiagnosticsTest"/>
            <class name="com.hi.api.tests.framework.PhaseRunnerTest"/>
            <class name="com.hi.api.tests.framework.LastExchangeTest"/>
            <class name="com.hi.api.dsl.TemplateRegistryTest"/>
            <class name="com.hi.api.dsl.TemplateChoiceTest"/>
            <class name="com.hi.api.dsl.TemplateManualSuiteTest"/>
            <class name="com.hi.api.dsl.ManualAuthTest"/>
            <class name="com.hi.api.dsl.SuiteNameTest"/>
            <class name="com.hi.api.dsl.OnboardingStageContractTest"/>
            <class name="com.hi.api.dsl.ManualPayloadGapsTest"/>
            <class name="com.hi.api.dsl.PhaseExpectationTest"/>
            <class name="com.hi.api.dsl.PhaseCaptureTest"/>

            <!-- Framework guards that were outside this suite, so a full
                 verify_all run never executed them. 26 classes were
                 outside it; these 16 need no HTTP, no database and no
                 credentials, which is this suite's contract, and they
                 add 171 tests in roughly 11 seconds. The rest stay out
                 on purpose: the db classes need a real Postgres, and the
                 data-driven ones reach jsonplaceholder over the network.

                 Two of these were quietly broken while unwatched.
                 MultiSourceDataProviderTest was missing four fixtures,
                 and RestStepTest pinned a generated template by content
                 hash. A guard nobody runs is not a guard. -->
            <class name="com.hi.api.tests.data.MultiSourceDataProviderTest"/>
            <class name="com.hi.api.tests.framework.AuthorDomainSurvivesRegenTest"/>
            <class name="com.hi.api.tests.framework.ConfigBeatsDerivedAliasTest"/>
            <class name="com.hi.api.tests.framework.CtxFieldsTest"/>
            <class name="com.hi.api.tests.framework.FailureDigestFieldPairingTest"/>
            <class name="com.hi.api.tests.framework.FrameworkPartialGapsTest"/>
            <class name="com.hi.api.tests.framework.IdentityPackCrossCaseTest"/>
            <class name="com.hi.api.tests.framework.IdentityVocabularyTest"/>
            <class name="com.hi.api.tests.framework.JdbcRowPublishTest"/>
            <class name="com.hi.api.tests.framework.MemberEmailAndPollStopTest"/>
            <class name="com.hi.api.tests.framework.NearMissKeyReportTest"/>
            <class name="com.hi.api.tests.framework.PhaseArgRowFallbackTest"/>
            <class name="com.hi.api.tests.framework.ResolverSpellingTest"/>
            <class name="com.hi.api.tests.framework.ResponseAssertsTest"/>
            <class name="com.hi.api.tests.framework.RestParamAliasTest"/>
            <class name="com.hi.api.tests.framework.RestStepTest"/>
            <class name="com.hi.api.tests.framework.RetryAnalyzerTest"/>
            <class name="com.hi.api.tests.framework.FlowStoppedTest"/>
            <class name="com.hi.api.tests.framework.KafkaPartitionsTest"/>
        </classes>
    </test>
</suite>
