<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Hand-written tests (com.hi.api.tests.manual).

    mvn test "-DsuiteXmlFile=src/test/resources/testng-manual.xml"

  Committed deliberately. `Suites/` is gitignored wholesale, so a suite file
  placed there cannot be shared - every author would have to recreate it,
  and nothing would ever list these tests. This lives beside
  testng-guards.xml, which is committed for the same reason.

  The trailing `.*` is REQUIRED, not cosmetic. A plain
  <package name="com.hi.api.tests.manual"/> does NOT recurse: measured on
  TestNG 7.10.2, a class in a sub-package was silently skipped by the plain
  form and picked up by `.*` (41 vs 42 tests on an identical tree). Since
  CreateTestCase.md tells authors to use an optional <area>/ sub-folder,
  the plain form would drop their tests without any error.

  UNLIKE the guards suite, these make REAL HTTP calls against the configured
  environment and create real accounts. They are NOT part of verify_all and
  must not be wired into it.
-->
<suite name="Manual" configfailurepolicy="continue">
    <test name="Manual">
        <packages>
            <package name="com.hi.api.tests.manual.*"/>
        </packages>
    </test>
</suite>
