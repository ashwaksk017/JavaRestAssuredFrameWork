<?xml version="1.0" encoding="UTF-8"?>
<!--
  DEBUG-enabled verbose config for troubleshooting the current
  Hilton stg test run. Framework loggers (com.ak.api.**) at DEBUG
  so retry-on-transient attempts, per-step diagnostics, and
  placeholder-resolution details are all visible. HTTP client
  libraries stay at WARN to prevent HttpClient wire-level noise
  from drowning the useful signal.

  To revert to lean output: change every DEBUG below to INFO.
  To go even louder (wire-level HTTP): change io.restassured to
  info (or debug) and org.apache.http to info.

  CREDENTIAL REDACTION
  Every event passes through SecretRedactingRewritePolicy before it
  reaches the console. This matters because DEBUG on com.ak.api dumps
  request bodies, and the console is routinely redirected to a file
  (mvn test > accountdashboard-full-run.log), so console output is
  durable rather than ephemeral. Redacting centrally here covers every
  log site at once - including generated code that gets rewritten on
  every converter run, where a per-call-site fix would not survive.

  The 'packages' attribute registers the policy without relying on
  log4j2 annotation-processor output being present in the build.

  Note: XML comments cannot contain the string of two consecutive
  hyphens, so this block uses single dashes throughout.
-->
<Configuration status="WARN" packages="com.ak.api.security">
    <Appenders>
        <Console name="ConsoleRaw" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
        <!-- All console output flows through the redactor. Loggers must
             reference "Console" (this Rewrite appender), never
             "ConsoleRaw" directly, or they bypass redaction. -->
        <Rewrite name="Console">
            <AppenderRef ref="ConsoleRaw"/>
            <SecretRedactingRewritePolicy/>
        </Rewrite>
    </Appenders>
    <Loggers>
        <!-- Framework code: shows retry-on-transient attempts,
             placeholder resolution, delay-step timing, all diagnostics. -->
        <Logger name="com.ak.api" level="debug"/>
        <!-- Emitted test classes under imported.*: shows every step's
             request/response body dump. Already emits at INFO by default;
             DEBUG surfaces any extra diagnostic the translator marked
             at that level (e.g. downgraded "Failed to delete..." lines
             from the b'.PROPER narrow fix). -->
        <Logger name="com.ak.api.tests" level="debug"/>
        <!-- Keep HTTP-client noise quiet. Bump these to info/debug ONLY
             if you need to inspect the raw wire (connection reuse,
             DNS, TLS handshakes). -->
        <Logger name="io.restassured" level="warn"/>
        <Logger name="org.apache.http" level="warn"/>
        <Logger name="org.apache.hc" level="warn"/>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
