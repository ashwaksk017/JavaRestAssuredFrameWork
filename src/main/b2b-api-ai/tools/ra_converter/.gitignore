# SoapUI project XMLs are inputs, not converter code. Keep local.
# Contents only -- git does not descend into an excluded DIRECTORY,
# so a negation for a file inside `input/` would never apply.
input/*
!input/README.md

# Python bytecode cache
__pycache__/
*.pyc

# Live Cursor API key -- copy from cursor_agent.json.example
cursor_agent.json
