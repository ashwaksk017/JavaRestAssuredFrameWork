<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hi.api</groupId>
    <artifactId>api-automation-restassured</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>API Automation Framework (Rest Assured 5)</name>
    <description>
        Standalone API automation framework using Rest Assured 5.x. Utility
        surface (RestUtilities / RestLoggerUtilityDataHolder / RestLogAppender)
        preserved from the BatchPaymentAutomation reference project;
        modernized to Rest Assured 5 (io.restassured), Java 17, TestNG 7.10.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <rest-assured.version>5.4.0</rest-assured.version>
        <testng.version>7.10.2</testng.version>
        <jackson.version>2.17.1</jackson.version>
        <poi.version>5.2.5</poi.version>
        <jooq.version>3.19.31</jooq.version>
        <log4j.version>2.23.1</log4j.version>
        <slf4j.version>2.0.13</slf4j.version>

        <!-- Reporting -->
        <allure.version>2.27.0</allure.version>
        <extentreports.version>5.1.2</extentreports.version>
        <aspectj.version>1.9.22</aspectj.version>

        <!-- Plugins -->
        <surefire.version>3.2.5</surefire.version>
        <compiler.version>3.13.0</compiler.version>
        <allure-maven.version>2.12.0</allure-maven.version>

        <!-- Which TestNG suite file to run. Override on the CLI, e.g.:
             mvn test "-DsuiteXmlFile=src/test/resources/testng-tags.xml" -->
        <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
        <!-- jOOQ codegen against live Postgres. Off by default so CI does not
             need Hilton DB. Enable:
             mvn generate-sources -Djooq.codegen.skip=false -Ddb.url=... -Ddb.user=... -Ddb.password=...
             Do not put real credentials here. -->
        <jooq.codegen.skip>true</jooq.codegen.skip>
        <db.url></db.url>
        <db.user></db.user>
        <db.password></db.password>
        <db.driver>org.postgresql.Driver</db.driver>
        <!-- OpenAPI models from src/main/resources/openapi/*.yaml. Off only if
             you need a compile without the generator plugin. -->
        <openapi.codegen.skip>true</openapi.codegen.skip>
        <!-- File name of the OpenAPI/Swagger spec inside
             src/main/resources/openapi/. A property, not a literal in
             inputSpec, because the name carries the API VERSION and so
             changes on every vendor release: -Dopenapi.spec=abc.yaml.
             com.hi.api.openapi.OpenApiModels reads the same key at runtime
             (Config.get), so one flag moves the build AND the classpath
             lookup together. Moving only one of them is the failure this
             property exists to prevent: models generated from one spec,
             bodies validated against another.
             (No double hyphen anywhere above: XML forbids it inside a
             comment, which is the same trap log4j2.xml documents.) -->
        <openapi.spec>ProgramAccounts-1.0.71.yaml</openapi.spec>
        <!-- Test sources that reference the generated models. Skipped
             alongside the generator, and restored by the `openapi-codegen`
             profile. A pattern rather than a hard-coded exclude so adding a
             second such test is a one-word change here. -->
        <openapi.test.excludes>**/OpenApiModelsTest.java</openapi.test.excludes>
        <!-- -Dconverter.precondition.skip=true bypasses the
             converted-output check (see maven-enforcer-plugin). -->
        <converter.precondition.skip>false</converter.precondition.skip>
        <openapi-generator.version>7.10.0</openapi-generator.version>
    </properties>

    <!-- Dependency BOMs -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured-bom</artifactId>
                <version>${rest-assured.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Rest Assured -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-path</artifactId>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Jackson (JSON serialization + POJO binding) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-csv</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>

        <!-- Apache POI: Excel (.xlsx / .xls) data-driven rows -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Jayway JsonPath: standard $-notation JsonPath spec, used
             alongside REST Assured's Groovy-based GPath. Kept as a
             first-class dep so tests can compile-time reference it. -->
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <version>2.9.0</version>
        </dependency>

        <!-- Datafaker: fake-data generator for POST bodies + templates.
             Modern maintained fork of the now-abandoned javafaker. -->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>2.4.2</version>
        </dependency>

        <!-- PostgreSQL JDBC driver: plain-JDBC / jOOQ Db utility uses this against
             a real Postgres when db.url is configured. Ships in main scope so
             production-shape tests can query the same DB the API writes to. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
        </dependency>

        <!-- jOOQ Open Source (Java 17): optional backend for Db when db.api=jooq,
             plus Db.withDsl() for fluent verification. Same SQL strings as JDBC. -->
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
            <version>${jooq.version}</version>
        </dependency>

        <!-- H2 (test scope): drives the self-contained H2QueryTest so the Db
             utility is proven end-to-end without needing a live Postgres. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>test</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- Reporting: Allure -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
        </dependency>

        <!-- Reporting: ExtentReports (v5, TestNG listener via extra artifact) -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- Fail fast, and legibly, when the converter has not run.

                 `com.hi.api.support` is converter OUTPUT: the framework
                 files are copied from tools/ra_converter/framework and
                 ImportedRestClient is generated from the converted suites.
                 It is gitignored on purpose, so a fresh clone does not have
                 it, and `mvn compile` then failed with 26 misleading
                 "package com.hi.api.support does not exist" errors that say
                 nothing about the cause. One clear message instead. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>require-converted-output</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${converter.precondition.skip}</skip>
                            <rules>
                                <requireFilesExist>
                                    <files>
                                        <file>${project.basedir}/src/main/java/com/hi/api/support/ImportedScenario.java</file>
                                        <file>${project.basedir}/src/main/java/com/hi/api/support/ImportedRestClient.java</file>
                                    </files>
                                    <message>
No converted output found -- this tree has not been through the converter yet.

  com.hi.api.support is GENERATED and gitignored, but the committed code
  (domain/, dsl/, rest/utilities/) imports it, so compilation cannot work
  until you convert at least once.

  1. Put your ReadyAPI / SoapUI project XML(s) in:
         tools/ra_converter/input/
     (see the README in that folder)

  2. Convert every XML in ONE run:
         python tools/ra_converter/ra_converter.py --input tools/ra_converter/input --output . --package-root com.hi.api --clean --max-name-len 40 --no-cursor-assist

  3. Then build as normal.

  To build without converting (framework-only checks), pass
  -Dconverter.precondition.skip=true -- compilation will still fail on the
  missing package, this only silences the precondition itself.
                                    </message>
                                </requireFilesExist>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.version}</version>
                <configuration>
                    <!-- Tests that compile only against openapi-generator
                         output. The spec that feeds the generator is
                         gitignored on purpose (vendor API contract, public
                         repo), so on a clone without it the models do not
                         exist and these files cannot compile, taking
                         java-compile AND java-tests down with them for a
                         reason unrelated to the change under test.

                         Excluded by default; the `openapi-codegen` profile
                         below puts them back when you enable generation with
                         -Dopenapi.codegen.skip=false, which is the only
                         configuration where they can compile at all. -->
                    <testExcludes>
                        <testExclude>${openapi.test.excludes}</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- AspectJ weaver so Allure @Step annotations attach at runtime -->
                    <argLine>
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                        -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8
                    </argLine>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                    <!-- TestNG configFailurePolicy=continue so a leftover
                         @AfterMethod throw does not skip every subsequent
                         @Test in the class. Soft-assert flush now stamps
                         ITestResult.FAILURE instead of rethrowing; this
                         still covers other config failures. Applies when
                         `mvn test -Dtest=X` bypasses Suites/*.xml. -->
                    <properties>
                        <property>
                            <name>configfailurepolicy</name>
                            <value>continue</value>
                        </property>
                    </properties>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- allure:report / allure:serve -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven.version}</version>
                <configuration>
                    <reportVersion>${allure.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                    <reportDirectory>${project.build.directory}/allure-report</reportDirectory>
                </configuration>
            </plugin>

            <!-- Models-only codegen from Program Accounts Swagger 2.0.
                 APIs stay Rest Assured; imported tests keep JsonPath + ctx. -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>program-accounts-models</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <skip>${openapi.codegen.skip}</skip>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/${openapi.spec}</inputSpec>
                            <generatorName>java</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <modelPackage>com.hi.api.openapi.programaccounts.model</modelPackage>
                            <apiPackage>com.hi.api.openapi.programaccounts.api</apiPackage>
                            <invokerPackage>com.hi.api.openapi.programaccounts</invokerPackage>
                            <generateApis>false</generateApis>
                            <generateApiTests>false</generateApiTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelTests>false</generateModelTests>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <skipValidateSpec>true</skipValidateSpec>
                            <configOptions>
                                <sourceFolder>src/main/java</sourceFolder>
                                <dateLibrary>java8</dateLibrary>
                                <serializationLibrary>jackson</serializationLibrary>
                                <library>native</library>
                                <openApiNullable>false</openApiNullable>
                                <useJakartaEe>false</useJakartaEe>
                                <useBeanValidation>false</useBeanValidation>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <legacyDiscriminatorBehavior>false</legacyDiscriminatorBehavior>
                                <annotationLibrary>none</annotationLibrary>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Optional: generate com.hi.api.db.generated from live Postgres.
                 Skipped unless -Djooq.codegen.skip=false and db.* are set. -->
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <version>${jooq.version}</version>
                <executions>
                    <execution>
                        <id>jooq-codegen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <skip>${jooq.codegen.skip}</skip>
                            <jdbc>
                                <driver>${db.driver}</driver>
                                <url>${db.url}</url>
                                <user>${db.user}</user>
                                <password>${db.password}</password>
                            </jdbc>
                            <generator>
                                <database>
                                    <name>org.jooq.meta.postgres.PostgresDatabase</name>
                                    <includes>.*</includes>
                                    <inputSchema>segment</inputSchema>
                                </database>
                                <target>
                                    <packageName>com.hi.api.db.generated</packageName>
                                    <directory>${project.build.directory}/generated-sources/jooq</directory>
                                </target>
                            </generator>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>42.7.4</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Activated by the same flag that turns the generator on:

              mvn test -Dopenapi.codegen.skip=false

          Generation and the tests that depend on it are one decision, so they
          are driven by one flag. Without this the two could disagree: models
          generated but their tests still excluded, or the tests compiled
          against models that were never generated. That second case is the
          failure this profile exists to remove: `cannot find symbol: class
          ProgramAccount` taking down java-compile and java-tests on any clone
          lacking the gitignored spec.

          Maven activates on a -D property, not on the <properties> default, so
          the everyday build stays on the safe path and only an explicit opt-in
          pulls these sources in.
        -->
        <profile>
            <id>openapi-codegen</id>
            <activation>
                <property>
                    <name>openapi.codegen.skip</name>
                    <value>false</value>
                </property>
            </activation>
            <properties>
                <!-- A pattern that matches nothing, so nothing is excluded.
                     Maven has no way to clear an inherited list, so the list
                     stays and its contents are neutralised. -->
                <openapi.test.excludes>**/__no_such_test__.java</openapi.test.excludes>
            </properties>
        </profile>
    </profiles>
</project>
